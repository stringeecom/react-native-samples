# Resolve react_native_pods.rb with node to allow for hoisting.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.0'
prepare_react_native_project!

# Flipper is not required by the sample and does not compile with current Xcode releases.
flipper_config = FlipperConfiguration.disabled

target 'LiveChatSample' do
  config = use_native_modules!

  # Stringee iOS SDK 2.2.0 (iOS 15+) is not published to the CocoaPods trunk.
  pod 'Stringee', :podspec => 'https://raw.githubusercontent.com/stringeecom/Stringee-iOS-SDK/2.2.0/Stringee.podspec'
  flags = get_default_flags()

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => flags[:hermes_enabled],
    :fabric_enabled => flags[:fabric_enabled],
    :flipper_configuration => flipper_config,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'LiveChatSampleTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    installer.pods_project.targets.each do |target|
      next unless target.name == 'Yoga'
      target.build_configurations.each do |build_config|
        flags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] =
          "#{flags} -Wno-deprecated-literal-operator"
      end
    end
    __apply_Xcode_12_5_M1_post_install_workaround(installer)
  end
end
