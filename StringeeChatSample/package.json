{
  "name": "StringeeChatSample",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "postinstall": "node scripts/fix-react-native-boost.js",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.3",
    "react-native-actions-sheet": "^0.5.8",
    "react-native-elements": "^3.4.2",
    "react-native-safe-area-context": "^4.7.1",
    "react-native-vector-icons": "^9.0.0",
    "stringee-react-native-v2": "^1.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/metro-config": "^0.72.9",
    "@react-native-community/eslint-config": "^2.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "7.14.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.7",
    "react-test-renderer": "18.2.0"
  },
  "jest": {
    "preset": "react-native",
    "collectCoverageFrom": [
      "App.js",
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=16"
  }
